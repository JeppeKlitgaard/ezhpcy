# {{ preset }} HPC configuration for EzHPCy.

log_level = "INFO"
auto_provision = true

[profile.base]
connection.host = "login.hpc.example.com"
connection.user = {{ user | tojson }}
connection.password_prompt = true
connection.ssh_keepalive_interval_seconds = 30

scheduler.type = "LSF"
scheduler.submission_mode = "batch"

resources.queue = "hpc-queue"

timings.queue_timeout_seconds = 900
timings.worker_startup_timeout_seconds = 120
timings.worker_heartbeat_interval_seconds = 30
timings.worker_heartbeat_timeout_seconds = 90
timings.job_poll_interval_seconds = 2.5
timings.job_monitor_interval_seconds = 60
