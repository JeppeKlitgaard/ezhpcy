#!/bin/sh
set -eu

openssh_matchspec={{ openssh_matchspec }}

if [ "$#" -ne 1 ]; then
    echo "Usage: ssh-serve PORT" >&2
    exit 2
fi

port=$1
case "$port" in
    ''|*[!0-9]*)
        echo "Worker SSH port must be numeric." >&2
        exit 2
        ;;
esac
if [ "$port" -lt 1024 ] || [ "$port" -gt 65535 ]; then
    echo "Worker SSH port must be between 1024 and 65535." >&2
    exit 2
fi

if [ -z "${LSB_JOBID+x}" ] && [ -z "${LSF_ENVDIR+x}" ] && [ -z "${PBS_JOBID+x}" ]; then
    echo "Worker SSH must run inside an LSF or PBS compute allocation." >&2
    exit 1
fi

xdg_cache_home="${XDG_CACHE_HOME:-$HOME/.cache}"
if [ -n "${XDG_RUNTIME_DIR:-}" ]; then
    runtime_dir="$XDG_RUNTIME_DIR/ezhpcy"
else
    runtime_dir="${TMPDIR:-/tmp}/ezhpcy-$(id -u)"
fi

pixi_home="$xdg_cache_home/ezhpcy/pixi/{{ pixi_version }}"
pixi_cache_dir="$xdg_cache_home/ezhpcy/pixi_cache/{{ pixi_version }}"
pixi="$pixi_home/bin/pixi"
sshd_config="$xdg_cache_home/ezhpcy/ssh/sshd_config"
sshd_pid="$runtime_dir/sshd-$$.pid"

if [ ! -x "$pixi" ]; then
    echo "Private Pixi executable was not found at $pixi." >&2
    exit 1
fi
if [ ! -f "$sshd_config" ]; then
    echo "Provisioned SSH configuration was not found at $sshd_config." >&2
    exit 1
fi

umask 077
mkdir -p "$runtime_dir"
chmod 0700 "$runtime_dir"
export PIXI_HOME="$pixi_home"
export PIXI_CACHE_DIR="$pixi_cache_dir"

run_sshd() {
    "$pixi" exec --spec="$openssh_matchspec" sh -c '
        sshd_path=$(command -v sshd) || exit
        case "$sshd_path" in
            /*) exec "$sshd_path" "$@" ;;
            *) echo "sshd must resolve to an absolute path" >&2; exit 1 ;;
        esac
    ' sshd "$@"
}

run_sshd -t -f "$sshd_config" -p "$port" \
    -o ListenAddress=0.0.0.0 -o "PidFile=$sshd_pid"

echo "Worker SSH endpoint: 0.0.0.0:$port" >&2
exec "$pixi" exec --spec="$openssh_matchspec" sh -c '
    sshd_path=$(command -v sshd) || exit
    case "$sshd_path" in
        /*) exec "$sshd_path" "$@" ;;
        *) echo "sshd must resolve to an absolute path" >&2; exit 1 ;;
    esac
' sshd -D -e -f "$sshd_config" -p "$port" \
    -o ListenAddress=0.0.0.0 -o "PidFile=$sshd_pid"
