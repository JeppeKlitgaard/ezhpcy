#!/bin/sh
set -eu

openssh_matchspec={{ openssh_matchspec }}

if [ "$#" -ne 5 ]; then
    echo "Usage: ssh-serve PORT MACHINE_ID CONNECTION_ID KEY_TYPE KEY_BLOB" >&2
    exit 2
fi

port=$1
machine_id=$2
connection_id=$3
key_type=$4
key_blob=$5
case "$port" in
    ''|*[!0-9]*)
        echo "Worker SSH port must be numeric." >&2
        exit 2
        ;;
esac
if [ "$port" -lt 1024 ] || [ "$port" -gt 65535 ]; then
    echo "Worker SSH port must be between 1024 and 65535." >&2
    exit 2
fi

case "$machine_id" in
    ''|*[!0-9a-f]*)
        echo "Local machine ID must be lowercase hexadecimal." >&2
        exit 2
        ;;
esac

case "$connection_id" in
    ''|.|..|*[!A-Za-z0-9._@%-]*)
        echo "SSH connection ID contains invalid characters." >&2
        exit 2
        ;;
esac

if [ "$key_type" != "ssh-ed25519" ]; then
    echo "Worker SSH key type must be ssh-ed25519." >&2
    exit 2
fi
case "$key_blob" in
    ''|*[!A-Za-z0-9+/=]*)
        echo "Worker SSH public key is malformed." >&2
        exit 2
        ;;
esac

if [ -z "${LSB_JOBID+x}" ] && [ -z "${LSF_ENVDIR+x}" ] && [ -z "${PBS_JOBID+x}" ]; then
    echo "Worker SSH must run inside an LSF or PBS compute allocation." >&2
    exit 1
fi

xdg_cache_home="${XDG_CACHE_HOME:-$HOME/.cache}"
ezhpcy_cache_dir="$xdg_cache_home/ezhpcy/{{ ezhpcy_version }}"
if [ -n "${XDG_RUNTIME_DIR:-}" ]; then
    runtime_dir="$XDG_RUNTIME_DIR/ezhpcy"
else
    runtime_dir="${TMPDIR:-/tmp}/ezhpcy-$(id -u)"
fi

pixi_home="$ezhpcy_cache_dir/pixi/{{ pixi_version }}"
pixi_cache_dir="$ezhpcy_cache_dir/pixi_cache/{{ pixi_version }}"
pixi="$pixi_home/bin/pixi"
host_key="$ezhpcy_cache_dir/ssh/$machine_id/$connection_id/ssh_host_ed25519_key"
sshd_pid="$runtime_dir/sshd-$$.pid"

if [ ! -x "$pixi" ]; then
    echo "Private Pixi executable was not found at $pixi." >&2
    exit 1
fi
if [ ! -f "$host_key" ]; then
    echo "Provisioned SSH host key was not found at $host_key." >&2
    exit 1
fi

umask 077
mkdir -p "$runtime_dir"
chmod 0700 "$runtime_dir"
export PIXI_HOME="$pixi_home"
export PIXI_CACHE_DIR="$pixi_cache_dir"

remote_username=$(id -un)
set -- \
    -f /dev/null \
    -o "HostKey=$host_key" \
    -o AuthorizedKeysFile=none \
    -o "AuthorizedKeysCommand=/bin/echo $key_type $key_blob" \
    -o "AuthorizedKeysCommandUser=$remote_username" \
    -o StrictModes=yes \
    -o PubkeyAuthentication=yes \
    -o AuthenticationMethods=publickey \
    -o PasswordAuthentication=no \
    -o KbdInteractiveAuthentication=no \
    -o PermitEmptyPasswords=no \
    -o PermitRootLogin=no \
    -o "AllowUsers=$remote_username" \
    -o HostbasedAuthentication=no \
    -o PermitUserEnvironment=no \
    -o AllowTcpForwarding=yes \
    -o GatewayPorts=no \
    -o AllowAgentForwarding=no \
    -o X11Forwarding=no \
    -o PermitTunnel=no \
    -o UseDNS=no \
    -o LogLevel=INFO \
    -o "Subsystem=sftp internal-sftp"

run_sshd() {
    "$pixi" exec --spec="$openssh_matchspec" sh -c '
        sshd_path=$(command -v sshd) || exit
        case "$sshd_path" in
            /*) exec "$sshd_path" "$@" ;;
            *) echo "sshd must resolve to an absolute path" >&2; exit 1 ;;
        esac
    ' sshd "$@"
}

run_sshd -t -p "$port" \
    -o ListenAddress=0.0.0.0 -o "PidFile=$sshd_pid" "$@"

echo "Worker SSH endpoint: 0.0.0.0:$port" >&2
exec "$pixi" exec --spec="$openssh_matchspec" sh -c '
    sshd_path=$(command -v sshd) || exit
    case "$sshd_path" in
        /*) exec "$sshd_path" "$@" ;;
        *) echo "sshd must resolve to an absolute path" >&2; exit 1 ;;
    esac
' sshd -D -e -p "$port" \
    -o ListenAddress=0.0.0.0 -o "PidFile=$sshd_pid" "$@"
